@page
@model wt_lab5_5razor_vasileva.Pages.Students.CreateModel

@{
    ViewData["Title"] = "Добавление студента";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="mb-4">Добавление студента</h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Student.FullName" class="form-label"></label>
                    <input asp-for="Student.FullName" class="form-control" />
                    <span asp-validation-for="Student.FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.Group" class="form-label"></label>
                    <input asp-for="Student.Group" class="form-control" />
                    <span asp-validation-for="Student.Group" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.AverageGrade" class="form-label"></label>
                    <input asp-for="Student.AverageGrade" class="form-control" />
                    <span asp-validation-for="Student.AverageGrade" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.EnrollmentYear" class="form-label"></label>
                    <input asp-for="Student.EnrollmentYear" class="form-control" />
                    <span asp-validation-for="Student.EnrollmentYear" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Student.Email" class="form-label"></label>
                    <input asp-for="Student.Email" class="form-control" />
                    <span asp-validation-for="Student.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-page="/Students/Index" class="btn btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}